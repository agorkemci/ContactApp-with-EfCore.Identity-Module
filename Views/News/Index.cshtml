@model IReadOnlyList<ContactApp.Contracts.DTOs.NewsArticleDto>

    <h1 class="mb-4">News</h1>

@if(Model.Count==0 || Model == null)
{
    <div class="alert alert-danger">
        There are no news to view ...

    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th>Published</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model)
                {
                    <tr>
                        <td><a asp-controller="News" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td>
                        <td>@item.AuthorName</td>
                        <td>@item.Status</td>
                        <td>@(item.PublishedAt?.ToString("yyyy-MM-dd HH:mm"))?? "-"</td>
                        <td> </td>
                        <td>Published</td>
                        <td>Summary</td>
                    </tr>
                }



            </tbody>
        </table>
    </div>
}