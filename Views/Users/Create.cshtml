@model UserViewModel
@{
    ViewData["Title"] = "Create New User with Role";
}

<h1>Create New User with Role</h1>
<div class="row">
    <div class="column-gap-md-4">
        <div asp-validation-summary="ModelOnly" class="text-bg-danger"></div>
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="UserName" class="control-label">Username:</label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-bg-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="Email" class="control-label">Email:</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-bg-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="Password" class="control-label">Password:</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-bg-danger"></span>
            </div>
                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-outline-primary">Save User</button>
                </div>
        </form>
        
    </div>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary mt-3">Return Back</a>
</div>

